{
  "manifest_version": 3,
  "name": "Kick VOD Resume - Continue Where You Left Off",
  "version": "1.0.0",
  "description": "Automatically saves your progress on Kick.com VODs and lets you resume playback from the exact second with a single click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Kick VOD Resume",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://kick.com/*",
    "*://*.kick.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://kick.com/*",
        "*://*.kick.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "commands": {
    "quick-save": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save current VOD playback time"
    }
  }
}
